{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "opsflow": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/ibm-plex-sans/latin-400.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-500.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-600.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-700.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-400.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-500.css",
              {
                "input": "src/styles/theme-light.less",
                "bundleName": "theme-light"
              },
              "src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "echarts",
              "zrender"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "portable": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all",
              "baseHref": "./",
              "outputPath": {
                "base": "dist-portable",
                "browser": ""
              },
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "opsflow:build:production"
            },
            "development": {
              "buildTarget": "opsflow:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": true
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "tsConfig": ".storybook/tsconfig.json",
            "compodoc": false,
            "styles": [
              "node_modules/@fontsource/ibm-plex-sans/latin-400.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-500.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-600.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-700.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-400.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-500.css",
              "src/styles/theme-light.less",
              "src/styles.scss"
            ],
            "experimentalZoneless": true,
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "tsConfig": ".storybook/tsconfig.json",
            "compodoc": false,
            "styles": [
              "node_modules/@fontsource/ibm-plex-sans/latin-400.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-500.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-600.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-700.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-400.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-500.css",
              "src/styles/theme-light.less",
              "src/styles.scss"
            ],
            "experimentalZoneless": true,
            "outputDir": "storybook-static"
          }
        }
      }
    }
  }
}
